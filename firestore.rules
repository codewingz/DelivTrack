rules_version = '2';

// DelivTrack: every user's data lives under users/{uid}/... and only that user may touch it.
// New collections are denied until a rule block is added for them (default deny).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Trimmed text with a length range.
    function trimmedText(value, minLen, maxLen) {
      return value is string
        && value.size() >= minLen && value.size() <= maxLen
        && value.matches('^[^\\s](.*[^\\s])?$');
    }

    function validProduct(data) {
      return data.keys().hasOnly(['name', 'nameLower', 'saleUnit', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['name', 'nameLower', 'saleUnit', 'isActive', 'createdAt', 'updatedAt'])
        && trimmedText(data.name, 2, 60)
        && data.nameLower == data.name.lower()
        && data.saleUnit in ['per_piece', 'per_kg']
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    // Products: created/edited/archived by their owner; never deleted (archive instead).
    match /users/{uid}/products/{productId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && validProduct(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
        && validProduct(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // Product-name guards (one doc per name; keeps names unique per user).
    match /users/{uid}/product_names/{nameKey} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['productId'])
        && request.resource.data.productId is string;
      allow update: if false;
    }

    function validCustomer(data) {
      return data.keys().hasOnly(['displayName', 'displayNameLower', 'phone', 'phoneNormalized', 'address', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['displayName', 'displayNameLower', 'phone', 'phoneNormalized', 'address', 'createdAt', 'updatedAt'])
        && trimmedText(data.displayName, 2, 60)
        && data.displayNameLower == data.displayName.lower()
        && trimmedText(data.phone, 10, 20)
        && data.phoneNormalized is string
        && data.phoneNormalized.matches('^[0-9]{10,15}$')
        && trimmedText(data.address, 5, 200)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    // Customers: name, phone and address are all mandatory. Never deleted.
    match /users/{uid}/customers/{customerId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && validCustomer(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
        && validCustomer(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // ---- Parcels -------------------------------------------------------------------------

    // The Pakistan calendar date (UTC+5, no daylight saving) of a timestamp, as yyyy-MM-dd.
    function pakistanDate(t) {
      let p = t + duration.value(5, 'h');
      return string(p.year()) + '-' + (p.month() < 10 ? '0' : '') + string(p.month()) + '-' + (p.day() < 10 ? '0' : '') + string(p.day());
    }

    function validDateString(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validParcelShape(data) {
      return data.keys().hasAll(['orderNumber', 'orderSequence', 'customerId', 'customerSnapshot', 'items',
          'collectionMethod', 'postalServiceType', 'postalReference', 'postalReferenceNormalized',
          'productAmountExpectedPaisa', 'receivedPaisa', 'outstandingPaisa', 'paymentStatus', 'parcelStatus',
          'sendingDateLocal', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['orderNumber', 'orderSequence', 'customerId', 'customerSnapshot', 'items',
          'collectionMethod', 'postalServiceType', 'otherPostalServiceName', 'postalReference',
          'postalReferenceNormalized', 'deliveryChargePaisa', 'actualPackedWeightGrams',
          'estimatedPaymentDateLocal', 'productAmountExpectedPaisa', 'receivedPaisa', 'outstandingPaisa',
          'paymentStatus', 'parcelStatus', 'sendingDateLocal', 'createdAt', 'updatedAt',
          'notes', 'returnedDateLocal', 'returnReason', 'paymentReviewRequired', 'isArchived', 'lastPaymentId',
          'paymentReviewReason', 'paymentReviewNote', 'paymentReviewDateLocal', 'paymentReviewResolvedAt', 'postalGuardId']);
    }

    // The status the app derives from the amounts (see paymentStatusFor).
    function statusFor(data) {
      return data.collectionMethod == 'free_gift' ? 'not_required'
        : (data.productAmountExpectedPaisa > 0 && data.receivedPaisa >= data.productAmountExpectedPaisa) ? 'received'
        : data.receivedPaisa > 0 ? 'partial'
        : 'pending';
    }

    // Field-level checks, including the money maths: outstanding = expected - received (never negative),
    // the payment status follows from the amounts, Gift / Free expects nothing.
    // Limit: rules cannot loop over `items` and Firestore caps one evaluation at 1,000 expressions, so
    // "expected = sum of the line totals" and "line total = quantity x price" are kept by the app (and
    // its tests); the rules only forbid changing the expected amount when the lines are not edited.
    function validParcel(data) {
      return validParcelShape(data)
        && data.orderNumber is string && data.orderNumber.matches('^ADT-[0-9]{6,}$')
        && data.orderSequence is int && data.orderSequence >= 1
        && int(data.orderNumber[4:]) == data.orderSequence
        && data.customerId is string && data.customerId.size() > 0 && data.customerId.size() <= 40
        && data.customerSnapshot is map
        && data.customerSnapshot.keys().hasOnly(['name', 'phone', 'address'])
        // name, phone and address are checked by `customerMatches` (they equal the customer's validated record)
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 20
        && data.collectionMethod in ['postal_collection', 'advance', 'credit', 'free_gift']
        && data.postalServiceType in ['VPP', 'VPL', 'VPR', 'Other']
        && (data.postalServiceType == 'Other'
            ? ('otherPostalServiceName' in data && trimmedText(data.otherPostalServiceName, 2, 40))
            : !('otherPostalServiceName' in data))
        && data.postalReference is string && data.postalReference.size() <= 40
        && data.postalReferenceNormalized is string && data.postalReferenceNormalized.matches('^[A-Z0-9/-]{0,30}$')
        && data.parcelStatus in ['draft', 'sent', 'returned']
        && (data.parcelStatus == 'draft' || (data.postalReferenceNormalized.size() >= 5 && 'deliveryChargePaisa' in data))
        && (!('deliveryChargePaisa' in data) || (data.deliveryChargePaisa is int && data.deliveryChargePaisa >= 0 && data.deliveryChargePaisa <= 9999999900))
        && (!('actualPackedWeightGrams' in data) || (data.actualPackedWeightGrams is int && data.actualPackedWeightGrams > 0 && data.actualPackedWeightGrams <= 9999999))
        && (!('estimatedPaymentDateLocal' in data) || (data.collectionMethod == 'credit' && validDateString(data.estimatedPaymentDateLocal)))
        && data.productAmountExpectedPaisa is int && data.productAmountExpectedPaisa >= 0
        && data.receivedPaisa is int && data.receivedPaisa >= 0
        && data.outstandingPaisa is int && data.outstandingPaisa >= 0
        && data.outstandingPaisa == (data.productAmountExpectedPaisa > data.receivedPaisa ? data.productAmountExpectedPaisa - data.receivedPaisa : 0)
        && (data.collectionMethod != 'free_gift' || data.productAmountExpectedPaisa == 0)
        && data.paymentStatus == statusFor(data)
        && (!('postalGuardId' in data) || (data.postalGuardId is string && data.postalGuardId.size() > 0 && data.postalGuardId.size() <= 160))
        && (!('lastPaymentId' in data) || (data.lastPaymentId is string && data.lastPaymentId.size() > 0 && data.lastPaymentId.size() <= 80))
        && validDateString(data.sendingDateLocal)
        && (!('notes' in data) || (data.notes is string && data.notes.size() >= 1 && data.notes.size() <= 500))
        && (!('isArchived' in data) || data.isArchived == true)
        && validReturnFields(data)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    // Return fields exist only on a returned parcel. Nothing is refunded automatically, so a returned
    // parcel that received or still owes money is flagged for payment review.
    function validReturnFields(data) {
      return data.parcelStatus == 'returned'
        ? ('returnedDateLocal' in data && validDateString(data.returnedDateLocal)
            && data.returnedDateLocal >= data.sendingDateLocal && data.returnedDateLocal <= pakistanDate(request.time)
            && 'paymentReviewRequired' in data
            && (!('paymentReviewResolvedAt' in data)
                ? (data.paymentReviewRequired == (data.receivedPaisa > 0 || data.outstandingPaisa > 0)
                    && !('paymentReviewReason' in data) && !('paymentReviewNote' in data) && !('paymentReviewDateLocal' in data))
                : (data.paymentReviewRequired == false && (data.receivedPaisa > 0 || data.outstandingPaisa > 0)
                    && data.paymentReviewResolvedAt is timestamp
                    && data.paymentReviewReason in ['refund_given', 'money_kept', 'balance_waived', 'other']
                    && trimmedText(data.paymentReviewNote, 5, 200)
                    && validDateString(data.paymentReviewDateLocal)
                    && data.paymentReviewDateLocal >= data.returnedDateLocal && data.paymentReviewDateLocal <= pakistanDate(request.time)))
            && (!('returnReason' in data) || (data.returnReason is string && data.returnReason.size() >= 1 && data.returnReason.size() <= 200)))
        : (!('returnedDateLocal' in data) && !('returnReason' in data) && !('paymentReviewRequired' in data)
            && !('paymentReviewResolvedAt' in data));
    }

    // Order-number counter: only ever +1 (a parcel create writes it in the same commit).
    match /users/{uid}/counters/orders {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['lastSequence'])
        && request.resource.data.lastSequence == 1;
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['lastSequence'])
        && request.resource.data.lastSequence == resource.data.lastSequence + 1;
      allow delete: if false;
    }

    // Postal-reference guards (one doc per service + reference; keeps references unique per user).
    match /users/{uid}/postal_refs/{refKey} {
      allow read: if isOwner(uid);
      // Created together with the parcel that points at it; released only in the commit that moves that
      // parcel to another reference (or clears it).
      allow delete: if isOwner(uid)
        && existsAfter(parcelAt(uid, resource.data.parcelId))
        && getAfter(parcelAt(uid, resource.data.parcelId)).data.updatedAt == request.time
        && getAfter(parcelAt(uid, resource.data.parcelId)).data.get('postalGuardId', '') != refKey;
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['parcelId', 'orderNumber'])
        && request.resource.data.parcelId is string
        && request.resource.data.orderNumber is string
        && existsAfter(parcelAt(uid, request.resource.data.parcelId))
        && getAfter(parcelAt(uid, request.resource.data.parcelId)).data.get('postalGuardId', '') == refKey;
      allow update: if false;
    }

    function guardAt(uid, guardId) {
      return /databases/$(database)/documents/users/$(uid)/postal_refs/$(guardId);
    }

    // A parcel's (service, reference) is reserved by a guard document created in the same commit and linked
    // to the parcel through `postalGuardId`. A second parcel with the same reference would need the same
    // guard id, which already exists and points at the first parcel, so it is refused.
    // For VPP / VPL / VPR the id is derived exactly as the app does ("VPP__ABC123", "/" written %2F). For
    // "Other" the id holds the URL-encoded free-text service name, which rules cannot reproduce: only its
    // shape, the reference part and the link to this parcel are checked, so uniqueness there is app-enforced.
    function guardOk(uid, parcelId, data) {
      return data.get('postalGuardId', '') != ''
        && existsAfter(guardAt(uid, data.postalGuardId))
        && getAfter(guardAt(uid, data.postalGuardId)).data.parcelId == parcelId
        && !exists(guardAt(uid, data.postalGuardId))
        && (data.postalServiceType == 'Other'
            ? data.postalGuardId.matches('^Other-.+__' + data.postalReferenceNormalized.replace('/', '%2F') + '$')
            : data.postalGuardId == data.postalServiceType + '__' + data.postalReferenceNormalized.replace('/', '%2F'));
    }

    function sameReference(a, b) {
      return a.postalServiceType == b.postalServiceType
        && a.get('otherPostalServiceName', '') == b.get('otherPostalServiceName', '')
        && a.postalReferenceNormalized == b.postalReferenceNormalized;
    }

    // The parcel's customer snapshot (name, phone, address) must be a copy of that customer's record.
    function customerMatches(uid, data) {
      let c = get(/databases/$(database)/documents/users/$(uid)/customers/$(data.customerId)).data;
      return c.displayName == data.customerSnapshot.name
        && c.phone == data.customerSnapshot.phone
        && c.address == data.customerSnapshot.address;
    }

    // Parcels: created with the next order number, never deleted.
    match /users/{uid}/parcels/{parcelId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && validParcel(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.sendingDateLocal == pakistanDate(request.time)
        && request.resource.data.receivedPaisa == 0
        && !('lastPaymentId' in request.resource.data)
        && customerMatches(uid, request.resource.data)
        && (request.resource.data.postalReferenceNormalized == ''
            ? !('postalGuardId' in request.resource.data)
            : guardOk(uid, parcelId, request.resource.data))
        && !('isArchived' in request.resource.data)
        && request.resource.data.paymentStatus in ['pending', 'not_required']
        && request.resource.data.parcelStatus in ['draft', 'sent']
        && getAfter(/databases/$(database)/documents/users/$(uid)/counters/orders).data.lastSequence == request.resource.data.orderSequence
        && (exists(/databases/$(database)/documents/users/$(uid)/counters/orders)
            ? get(/databases/$(database)/documents/users/$(uid)/counters/orders).data.lastSequence == request.resource.data.orderSequence - 1
            : request.resource.data.orderSequence == 1);
      allow update: if isOwner(uid)
        && validParcel(request.resource.data)
        && request.resource.data.orderNumber == resource.data.orderNumber
        && request.resource.data.orderSequence == resource.data.orderSequence
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.sendingDateLocal == resource.data.sendingDateLocal
        // An archived parcel cannot be edited; the only change allowed is restoring it. A parcel can be
        // archived only when nothing is left to chase (a draft, a returned parcel, or nothing owed) and no
        // payment review is open; archiving changes nothing else.
        && (request.resource.data.get('isArchived', false) == resource.data.get('isArchived', false)
            ? !resource.data.get('isArchived', false)
            : (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isArchived', 'updatedAt'])
                && (resource.data.get('isArchived', false)
                    || (!resource.data.get('paymentReviewRequired', false)
                        && (resource.data.parcelStatus in ['draft', 'returned']
                            || resource.data.outstandingPaisa == 0)))))
        // The expected amount can change only together with the item lines.
        && (request.resource.data.items != resource.data.items
            || request.resource.data.productAmountExpectedPaisa == resource.data.productAmountExpectedPaisa
            || request.resource.data.collectionMethod != resource.data.collectionMethod)
        // The reference guard follows the reference: unchanged reference keeps the same guard; a new one needs
        // a new guard created in this commit (and none when the reference is cleared).
        && (sameReference(request.resource.data, resource.data)
            ? request.resource.data.get('postalGuardId', '') == resource.data.get('postalGuardId', '')
            : (request.resource.data.postalReferenceNormalized == ''
                ? !('postalGuardId' in request.resource.data)
                : guardOk(uid, parcelId, request.resource.data)))
        // The customer snapshot stays as it is, unless it is replaced by a copy of the (new) customer's record.
        && ((request.resource.data.customerId == resource.data.customerId
              && request.resource.data.customerSnapshot == resource.data.customerSnapshot)
            || customerMatches(uid, request.resource.data))
        // Received money moves only together with a NEW payment document (the payment rules below then
        // check the amount); nothing else may touch `lastPaymentId`.
        && (request.resource.data.receivedPaisa == resource.data.receivedPaisa
            ? request.resource.data.get('lastPaymentId', '') == resource.data.get('lastPaymentId', '')
            : (request.resource.data.get('lastPaymentId', '') != resource.data.get('lastPaymentId', '')
                && request.resource.data.get('lastPaymentId', '') != ''
                && existsAfter(paymentAt(uid, parcelId, request.resource.data.lastPaymentId))
                && !exists(paymentAt(uid, parcelId, request.resource.data.lastPaymentId))))
        // A returned parcel only takes notes; Sent -> Returned changes nothing but the return fields.
        && (resource.data.parcelStatus != 'returned'
            || (request.resource.data.parcelStatus == 'returned'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'isArchived', 'updatedAt']))
            // completing the payment review: only the review fields change, once, and only the money flag clears
            || (request.resource.data.parcelStatus == 'returned'
                && resource.data.get('paymentReviewRequired', false) == true
                && !('paymentReviewResolvedAt' in resource.data)
                && request.resource.data.paymentReviewResolvedAt == request.time
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentReviewRequired', 'paymentReviewReason',
                    'paymentReviewNote', 'paymentReviewDateLocal', 'paymentReviewResolvedAt', 'updatedAt'])))
        && (request.resource.data.parcelStatus != 'returned' || resource.data.parcelStatus == 'returned'
            || (resource.data.parcelStatus == 'sent'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parcelStatus', 'returnedDateLocal', 'returnReason', 'paymentReviewRequired', 'updatedAt'])))
        // A changed Pay Later date must be today or later.
        && (!('estimatedPaymentDateLocal' in request.resource.data)
            || ('estimatedPaymentDateLocal' in resource.data && resource.data.estimatedPaymentDateLocal == request.resource.data.estimatedPaymentDateLocal)
            || request.resource.data.estimatedPaymentDateLocal >= pakistanDate(request.time));
      allow delete: if false;
    }

    // Payments: append-only, written in the same commit that moves the parcel's received amount.
    //  * a payment (positive) never exceeds what is outstanding and never lands on a Gift / Free or
    //    returned parcel; it may carry an earlier "received on" date (not in the future, not before sending);
    //  * a correction reverses an earlier payment with a negative twin (document id "rev_<payment id>", so
    //    each payment can be reversed once) and may add one replacement ("cor_<payment id>") in the same commit.
    function parcelAt(uid, parcelId) {
      return /databases/$(database)/documents/users/$(uid)/parcels/$(parcelId);
    }

    function paymentAt(uid, parcelId, paymentId) {
      return /databases/$(database)/documents/users/$(uid)/parcels/$(parcelId)/payments/$(paymentId);
    }

    function paymentFields(data, extra) {
      return data.keys().hasAll(['amountPaisa', 'paymentType', 'receivedAt', 'recordedAt'])
        && data.keys().hasOnly(['amountPaisa', 'paymentType', 'note', 'receivedAt', 'recordedAt'].concat(extra))
        && data.amountPaisa is int && data.amountPaisa >= -9999999900 && data.amountPaisa <= 9999999900 && data.amountPaisa != 0
        && data.paymentType in ['advance', 'post_office_remittance', 'customer_payment']
        && (!('note' in data) || (data.note is string && data.note.size() <= 200))
        && data.recordedAt == request.time;
    }

    match /users/{uid}/parcels/{parcelId}/payments/{paymentId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && (
        // a payment
        (paymentFields(request.resource.data, [])
          && request.resource.data.amountPaisa > 0
          && !paymentId.matches('^(rev|cor)_.*')
          && (request.resource.data.receivedAt == request.time
              || (request.resource.data.receivedAt is timestamp && request.resource.data.receivedAt < request.time
                  && pakistanDate(request.resource.data.receivedAt) >= get(parcelAt(uid, parcelId)).data.sendingDateLocal))
          && get(parcelAt(uid, parcelId)).data.parcelStatus != 'returned'
          && !get(parcelAt(uid, parcelId)).data.get('isArchived', false)
          && get(parcelAt(uid, parcelId)).data.collectionMethod != 'free_gift'
          && request.resource.data.amountPaisa <= get(parcelAt(uid, parcelId)).data.outstandingPaisa
          && getAfter(parcelAt(uid, parcelId)).data.receivedPaisa
              == get(parcelAt(uid, parcelId)).data.receivedPaisa + request.resource.data.amountPaisa)
        // the reversal half of a correction
        || (paymentId.matches('^rev_.+')
          && paymentFields(request.resource.data, ['reversalOfPaymentId', 'correctionReason', 'replacementPaisa'])
          && request.resource.data.keys().hasAll(['reversalOfPaymentId', 'correctionReason', 'replacementPaisa'])
          && request.resource.data.amountPaisa < 0
          && request.resource.data.receivedAt == request.time
          && request.resource.data.reversalOfPaymentId == paymentId[4:]
          && trimmedText(request.resource.data.correctionReason, 5, 200)
          && request.resource.data.replacementPaisa is int
          && request.resource.data.replacementPaisa >= 0 && request.resource.data.replacementPaisa <= 9999999900
          && get(paymentAt(uid, parcelId, paymentId[4:])).data.amountPaisa == -request.resource.data.amountPaisa
          && get(paymentAt(uid, parcelId, paymentId[4:])).data.paymentType == request.resource.data.paymentType
          && get(parcelAt(uid, parcelId)).data.parcelStatus != 'returned'
          && !get(parcelAt(uid, parcelId)).data.get('isArchived', false)
          && getAfter(parcelAt(uid, parcelId)).data.receivedPaisa
              == get(parcelAt(uid, parcelId)).data.receivedPaisa + request.resource.data.amountPaisa + request.resource.data.replacementPaisa
          && getAfter(parcelAt(uid, parcelId)).data.receivedPaisa <= get(parcelAt(uid, parcelId)).data.productAmountExpectedPaisa
          && (request.resource.data.replacementPaisa == 0
              || (existsAfter(paymentAt(uid, parcelId, 'cor_' + paymentId[4:]))
                  && getAfter(paymentAt(uid, parcelId, 'cor_' + paymentId[4:])).data.amountPaisa == request.resource.data.replacementPaisa)))
        // the replacement half of a correction (checked together with its reversal)
        || (paymentId.matches('^cor_.+')
          && paymentFields(request.resource.data, ['correctionOfPaymentId'])
          && request.resource.data.keys().hasAll(['correctionOfPaymentId'])
          && request.resource.data.amountPaisa > 0
          && request.resource.data.receivedAt == request.time
          && request.resource.data.correctionOfPaymentId == paymentId[4:]
          && existsAfter(paymentAt(uid, parcelId, 'rev_' + paymentId[4:]))
          && getAfter(paymentAt(uid, parcelId, 'rev_' + paymentId[4:])).data.replacementPaisa == request.resource.data.amountPaisa
          && getAfter(paymentAt(uid, parcelId, 'rev_' + paymentId[4:])).data.paymentType == request.resource.data.paymentType)
      );
      allow update, delete: if false;
    }

    // Audit log: one entry per edit of a parcel. Written together with the edit, never changed.
    match /users/{uid}/audit_logs/{logId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['entityType', 'entityId', 'action', 'orderNumber', 'changedFields', 'createdAt'])
        && request.resource.data.keys().hasAll(['entityType', 'entityId', 'action', 'changedFields', 'createdAt'])
        && request.resource.data.entityType in ['parcel']
        && request.resource.data.entityId is string && request.resource.data.entityId.size() > 0 && request.resource.data.entityId.size() <= 40
        && request.resource.data.action in ['update', 'return', 'correct_payment', 'archive', 'restore', 'resolve_review']
        && request.resource.data.changedFields is list
        && request.resource.data.changedFields.size() >= 1 && request.resource.data.changedFields.size() <= 30
        && (!('orderNumber' in request.resource.data) || request.resource.data.orderNumber.matches('^ADT-[0-9]{6,}$'))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
